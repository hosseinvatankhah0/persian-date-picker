{
  "name": "ng2-jalali-date-picker-modal",
  "version": "1.0.0",
  "description": "A modern, standalone Jalali (Persian) date picker modal for Angular 22 — with day/month/time/daytime modes, RTL support, and ControlValueAccessor integration.",
  "keywords": [
    "angular",
    "angular22",
    "jalali",
    "persian",
    "shamsi",
    "date-picker",
    "datepicker",
    "modal",
    "date-picker-modal",
    "jalali-date-picker",
    "standalone",
    "signals",
    "control-value-accessor"
  ],
  "license": "MIT",
  "author": "ng2-jalali-date-picker-modal contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/ng2-jalali-date-picker-modal.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/ng2-jalali-date-picker-modal/issues"
  },
  "homepage": "https://github.com/your-org/ng2-jalali-date-picker-modal#readme",
  "dependencies": {
    "tslib": "^2.6.0"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "jalali-moment": "^3.3.11",
    "rxjs": "~7.8.0"
  },
  "module": "fesm2022/ng2-jalali-date-picker-modal.mjs",
  "typings": "types/ng2-jalali-date-picker-modal.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/ng2-jalali-date-picker-modal.d.ts",
      "default": "./fesm2022/ng2-jalali-date-picker-modal.mjs"
    }
  },
  "sideEffects": false,
  "type": "module"
}
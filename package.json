{
  "name": "persian-date-picker-angular",
  "version": "3.0.2",
  "description": "Angular 22 Persian (Jalali/Shamsi) date picker with modal and dropdown calendars, date ranges, time selection, typed input, and reactive forms.",
  "keywords": [
    "angular",
    "angular22",
    "jalali",
    "jalali-calendar",
    "persian",
    "persian-calendar",
    "shamsi",
    "shamsi-datepicker",
    "date-picker",
    "angular-datepicker",
    "angular-date-picker",
    "range-picker",
    "date-range",
    "date-time-picker",
    "datepicker",
    "modal",
    "date-picker-modal",
    "jalali-date-picker",
    "standalone",
    "reactive-forms",
    "rtl",
    "signals",
    "control-value-accessor"
  ],
  "license": "MIT",
  "author": "persian-date-picker contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/hosseinvatankhah0/persian-date-picker.git"
  },
  "bugs": {
    "url": "https://github.com/hosseinvatankhah0/persian-date-picker/issues"
  },
  "homepage": "https://github.com/hosseinvatankhah0/persian-date-picker#readme",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build persian-date-picker",
    "publish:lib": "npm run build:lib && cd dist/persian-date-picker && npm publish",
    "test": "ng test persian-date-picker --watch=false",
    "test:navigation": "ng test persian-date-picker --watch=false --include=month-calendar/navigation.regression.spec.ts",
    "build:playground": "ng build playground",
    "prepublishOnly": "node -e \"console.error('Refusing to publish from the repo root. Run: npm run build:lib && cd dist/persian-date-picker && npm publish'); process.exit(1)\""
  },
  "dependencies": {
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/moment-jalaali": "^0.7.0",
    "jasmine-core": "~5.1.0",
    "jsdom": "^30.0.1",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "less": "^4.2.0",
    "ng-packagr": "^22.0.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "jalali-moment": "^3.3.11",
    "rxjs": "~7.8.0"
  }
}
